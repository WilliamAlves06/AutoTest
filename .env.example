# Credenciais e caminhos sensíveis do AutoTest.
# Copie este arquivo para `.env` e preencha. O `.env` é ignorado pelo git
# (nunca versione credenciais). A aba "Configurações" do app grava aqui.

FC_LOGIN=seu_usuario
FC_SENHA=sua_senha

# Opcional: sobrescreve o caminho do executável do Formula Certa.
# FC_EXE_PATH=C:\Fcerta\fcerta.exe
